#version 450
#extension GL_GOOGLE_include_directive : require
// Test kernel for hdr/bb_composite.glsl (docs/hdr-tools/bb_composite_check/run.sh).
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer Cb { float cb[]; };
layout(std430, binding = 1) readonly buffer In { vec4 data[]; };
layout(std430, binding = 2) writeonly buffer Out { vec4 outv[]; };
layout(std430, binding = 3) readonly buffer Opt { int opt[]; };
float bb_c(uint w) { return cb[w]; }
#include "bb_composite.glsl"
void main() {
    uint i = gl_GlobalInvocationID.x;
    BbComposite o = BbComposite(opt[0], opt[1] != 0, opt[2], opt[3] != 0, opt[4] != 0, opt[5] != 0,
                                opt[6] != 0, opt[7] != 0);
    vec4 scene = data[4 * i], mult = data[4 * i + 1], bloom = data[4 * i + 2], uv = data[4 * i + 3];
    outv[3 * i] = vec4(bb_composite_sdr(o, scene, mult.rgb, bloom.rgb, uv.xy), 0.0);
    vec3 x = bb_exposed(o, scene, bb_scene_tint(mult.rgb), uv.xy);
    vec3 hdr;
    bool ok = bb_curve_hdr(o, x, 0.6, 4.93, hdr);
    outv[3 * i + 1] = vec4(bb_curve(o, x), ok ? 1.0 : 0.0);
    outv[3 * i + 2] = vec4(hdr, 0.0);
}
