#version 450
#extension GL_GOOGLE_include_directive : require
// Test kernel for hdr/bb_composite.glsl (docs/hdr-tools/bb_composite_check/run.sh).
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer Cb { float cb[]; };
layout(std430, binding = 1) readonly buffer In { vec4 data[]; };
layout(std430, binding = 2) writeonly buffer Out { vec4 outv[]; };  // 5 per pixel
layout(std430, binding = 3) readonly buffer Opt { int opt[]; };
float bb_c(uint w) { return cb[w]; }
#include "bb_composite.glsl"
#include "psychov30.glsl"
void main() {
    uint i = gl_GlobalInvocationID.x;
    BbComposite o = BbComposite(opt[0], opt[1] != 0, opt[2], opt[3] != 0, opt[4] != 0, opt[5] != 0,
                                opt[6] != 0, opt[7] != 0, opt[8] != 0, opt[9] != 0, opt[10] != 0,
                                opt[11] != 0);
    vec4 scene = data[4 * i], mult = data[4 * i + 1], bloom = data[4 * i + 2], uv = data[4 * i + 3];
    outv[5 * i] = vec4(bb_composite_sdr(o, scene, mult.rgb, bloom.rgb, uv.xy), 0.0);
    vec3 x = bb_exposed(o, scene, bb_scene_tint(mult.rgb), uv.xy);
    vec3 hdr;
    bool ok = bb_curve_hdr(o, x, 0.6, 4.93, hdr);
    outv[5 * i + 1] = vec4(bb_curve(o, x), ok ? 1.0 : 0.0);
    outv[5 * i + 2] = vec4(hdr, 0.0);
    // PsychoV30 matched to the curve at mid grey (as hdr/bb_composite_hdr.frag): at the grey
    // input, and at x and 4 x (it must rise).
    float grey, slope;
    bool pk = o.curve != 3 && bb_knee(o.curve, 0.18, grey, slope);
    float contrast = pk ? clamp(grey * slope / 0.18, 0.3, 3.0) : 1.0;
    vec3 xg = max(x, BB_FLOOR);  // as hdr/bb_composite_hdr.frag
    vec3 at_grey = rd_psychov30(vec3(grey), 4.93, 1.0, 1.0, 1.0, contrast, 1.0, 1.0, vec3(grey),
                                vec3(0.18), 1.0, 0, 1.0, RD_PSY30_SOURCE_BOUNDARY_BT709);
    vec3 at_x = rd_psychov30(xg, 4.93, 1.0, 1.0, 1.0, contrast, 1.0, 1.0, vec3(grey), vec3(0.18),
                             1.0, 0, 1.0, RD_PSY30_SOURCE_BOUNDARY_BT709);
    vec3 at_4x = rd_psychov30(4.0 * xg, 4.93, 1.0, 1.0, 1.0, contrast, 1.0, 1.0, vec3(grey),
                              vec3(0.18), 1.0, 0, 1.0, RD_PSY30_SOURCE_BOUNDARY_BT709);
    outv[5 * i + 3] = vec4(at_grey, pk ? 1.0 : 0.0);
    outv[5 * i + 4] = vec4(bb_mean(at_x), bb_mean(at_4x), max(max(at_x.r, at_x.g), at_x.b), 0.0);
}
